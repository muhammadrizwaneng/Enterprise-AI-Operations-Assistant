DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/enterprise_ai
APP_NAME=Enterprise AI Operations Assistant
APP_ENV=development
DEBUG=true
DATASET_SEED=42

# --- LLM / Chat (Phase 1) ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
LLM_MAX_HISTORY_MESSAGES=20
LLM_SYSTEM_PROMPT=You are the Enterprise AI Operations Assistant for NovaForge. Be concise, accurate, and helpful.

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Embeddings (Phase 2) — nomic-embed-text → 768-d vectors
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=60

# Semantic search (Phase 3)
SEMANTIC_SEARCH_DEFAULT_TOP_K=5
SEMANTIC_SEARCH_MAX_TOP_K=20

# RAG (Phase 4) — grounded answers (stateless; does not use chat history)
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.5
RAG_TEMPERATURE=0.2

# Future API providers (optional — never commit real keys)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
